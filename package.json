{
  "name": "tinu-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tinu/web",
    "dev:mobile": "turbo run dev --filter=@tinu/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "lefthook": "^1.13.6",
    "prettier": "^3.5.1",
    "turbo": "^2.4.0",
    "typescript": "^5"
  }
}
